# StockSentinel Configuration Example

# This file shows example configuration for StockSentinel GitHub App
# Copy this to .env and update with your actual values

# GitHub App Configuration
GITHUB_APP_ID=your_app_id_here
GITHUB_APP_INSTALLATION_ID=your_installation_id_here
GITHUB_PRIVATE_KEY_PATH=/path/to/private-key.pem

# Webhook Configuration (Optional)
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_PORT=3000

# Stock Monitoring Configuration
STOCK_SYMBOLS=AAPL,GOOGL,MSFT,TSLA,AMZN
UPDATE_INTERVAL=300  # seconds
PRICE_THRESHOLD=5  # percentage change to trigger alert

# Alert Configuration
ENABLE_ISSUE_ALERTS=true
ENABLE_PR_UPDATES=true
ALERT_RECIPIENTS=owner,collaborators

# API Configuration (if using external stock data API)
STOCK_API_KEY=your_api_key_here
STOCK_API_URL=https://api.stockdata.example.com

# Repository Configuration
DEFAULT_BRANCH=main
DATA_DIRECTORY=stock-data

# Logging
LOG_LEVEL=info
LOG_FILE=stocksentinel.log
